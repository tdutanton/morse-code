<Window x:Class="MorseCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Морзе · Русский алфавит" Width="920" Height="760"
        MinWidth="720" MinHeight="640" Background="#F5F4EF"
        FontFamily="Segoe UI" FontSize="15" Foreground="#202E2B"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="МОРЗЕ / РУССКИЙ АЛФАВИТ" FontSize="12" Foreground="#166B63"/>
            <TextBlock Text="Слушайте. Узнавайте. Передавайте." FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="33 буквы и 10 цифр. Один сигнал за раз." Foreground="#63726C" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="16" Background="#EAEDE7" Margin="0,0,0,20" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Набор символов" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="GroupBox" SelectedIndex="0" SelectionChanged="SettingsChanged">
                        <ComboBoxItem Content="Русские буквы"/>
                        <ComboBoxItem Content="Цифры"/>
                        <ComboBoxItem Content="Буквы и цифры"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                    <TextBlock x:Name="SpeedLabel" Text="Скорость: 12 слов/мин" FontSize="12" Margin="0,0,0,12"/>
                    <Slider x:Name="SpeedSlider" Minimum="5" Maximum="30" Value="12"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"
                            AutomationProperties.Name="Скорость сигнала"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl x:Name="Tabs" Grid.Row="2" Background="White" BorderBrush="#D5DDD6" SelectionChanged="TabChanged">
            <TabItem Header="Изучение">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="235"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="AlphabetList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SymbolChanged" AutomationProperties.Name="Справочник азбуки Морзе">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="84" Margin="4,7">
                                    <TextBlock Text="{Binding Letter}" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DisplayCode}" FontFamily="Consolas" FontSize="15" Foreground="#166B63"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="20,8,0,0">
                        <TextBlock Text="ВЫБРАННЫЙ СИМВОЛ" FontSize="11" Foreground="#63726C"/>
                        <TextBlock x:Name="SelectedLetter" FontSize="76" FontWeight="Light"/>
                        <TextBlock x:Name="SelectedCode" FontFamily="Consolas" FontSize="26" Margin="0,0,0,20"/>
                        <Button Content="Прослушать" Click="PlayStudy"/>
                        <TextBlock Text="Точка — 1 доля.&#10;Тире — 3 доли.&#10;Пауза внутри буквы — 1 доля."
                                   TextWrapping="Wrap" Margin="0,24,0,0" FontSize="13" Foreground="#63726C"/>
                        <TextBlock Text="Е и Ё звучат одинаково." TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" Foreground="#63726C"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Проверка">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,20">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Left" SelectionChanged="SettingsChanged">
                                <ComboBoxItem Content="На слух → символ"/>
                                <ComboBoxItem Content="Символ → код Морзе"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Сбросить счёт" Click="ResetScore"/>
                        </Grid>
                        <TextBlock x:Name="ScoreLabel" Text="Верно: 0 из 0" Margin="0,16,0,0" Foreground="#63726C"/>
                        <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" Margin="0,20,0,0"/>
                        <TextBlock x:Name="QuestionLabel" FontSize="52" FontWeight="Light" Margin="0,6,0,12"/>
                        <Button x:Name="ListenButton" Content="Слушать сигнал" Click="PlayQuestion" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        <TextBox x:Name="AnswerBox" FontSize="24" Padding="12,8" MaxLength="40"
                                 KeyDown="AnswerKeyDown" AutomationProperties.Name="Ваш ответ"/>
                        <TextBlock x:Name="InputHint" FontSize="12" Foreground="#63726C" Margin="0,6,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckButton" Content="Проверить" Click="CheckAnswer"/>
                            <Button x:Name="RevealButton" Content="Показать ответ" Click="RevealAnswer"/>
                            <Button x:Name="NextButton" Content="Далее" Click="NextQuestion" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="FeedbackLabel" TextWrapping="Wrap" Margin="0,16,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusLabel" Grid.Row="3" Text="Выберите символ, чтобы увидеть и услышать его код."
                   Foreground="#63726C" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
